{
  "name": "course-simplifier",
  "version": "1.0.0",
  "type": "module",
  "description": "Turn difficult course content into clear explanations, quizzes, and revision notes.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && npm run typecheck:functions && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:functions": "tsc --noEmit -p netlify/functions/tsconfig.json",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts",
    "dev:streamlit": "python -m streamlit run app.py",
    "install:py": "pip install -r requirements.txt"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@netlify/functions": "^6.1.1",
    "@netlify/vite-plugin": "^3.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.7"
  }
}
